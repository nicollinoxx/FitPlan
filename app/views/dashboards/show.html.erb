<% content_for :title, t('.title') %>

<div class="d-flex justify-content-between align-items-center">
  <h1><%= t('.title') %></h1>

  <%= link_to global_rankings_path, data: { controller: "bridge--nav-button", bridge_title: t('link_rankings') }, class: 'btn btn-sm btn-light border flex-shrink-0' do %>
    <i class="bi bi-trophy me-1"></i> <%= t('link_rankings') %>
  <% end %>
</div>

<div data-controller="hint">
  <div class="row g-3 mb-3">
    <%= render 'card', accent: 'orange',  title: t('.cards.imc'), hint: t('.hints.imc'), content: "#{@healthy_metric&.imc || 0} kg/m²", icon: "bi bi-person-fill" %>
    <%= render 'card', accent: 'orange',  title: t('.cards.tmb'), hint: t('.hints.tmb'), content: "#{@healthy_metric&.tmb || 0} kcal/dia", icon: "bi bi-lightning-charge-fill" %>
    <%= render 'card', accent: 'orange',  title: t('.cards.total_calories'), hint: t('.hints.total_calories'), content: "#{@total_diet_calories} kcal", icon: "bi bi-fire" %>
    <%= render 'card', accent: 'orange',  title: t('.cards.average_calories'), hint: t('.hints.average_calories'), content: "#{@average_diet_calories} kcal", icon: "bi bi-activity" %>
    <%= render 'card', accent: 'success', title: t('.cards.completions_today'), hint: t('.hints.completions_today'), content: @total_completions_today, icon: "bi bi-check-circle" %>
    <%= render 'card', accent: 'success', title: t('.cards.total_completions'), hint: t('.hints.total_completions'), content: @total_completions, icon: "bi bi-bar-chart" %>
    <%= render 'card', accent: 'success', title: t('.cards.streak'), hint: t('.hints.streak'), content: "#{@streak} #{t('.cards.days')}", icon: "bi bi-trophy" %>
    <%= render 'card', accent: 'success', title: t('.cards.best_day'), hint: t('.hints.best_day'), content: @best_day ? t("date.day_names")[@best_day] : "-", icon: "bi bi-star" %>
  </div>

  <div class="modal fade" tabindex="-1" aria-hidden="true" data-hint-target="dialog">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title h6 mb-0" data-hint-target="title"></h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body text-body-secondary" data-hint-target="body"></div>
      </div>
    </div>
  </div>
</div>

<% if @weekly_progress[:last_week] > 0 || @weekly_progress[:this_week] > 0 %>
  <div class="bg-body-tertiary rounded border-bottom border-orange p-3 mb-3">
    <div class="d-flex justify-content-between align-items-center mb-2 ">
      <h6 class="mb-0"><i class="bi bi-bar-chart text-orange"></i> <%= t('.weekly_progress.title') %></h6>
      <small class="text-muted"><%= @weekly_progress[:this_week] %> / <%= @weekly_progress[:last_week] %> <%= t('.weekly_progress.vs_last_week') %></small>
    </div>
    <p class="text-muted small mb-2"><%= t('.weekly_progress.description') %></p>
    <div class="progress" style="height: 8px;">
      <div class="progress-bar bg-orange" style="width: <%= @weekly_progress[:percentage] %>%"></div>
    </div>
  </div>
<% end %>

<%= turbo_frame_tag :charts do %>
  <div class="my-5">
    <%= render "shared/paginables/next_page_container", src: charts_dashboard_path(period: params[:period], format: :turbo_stream) %>
  </div>
<% end %>
