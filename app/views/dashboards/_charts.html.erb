<%= turbo_frame_tag :charts do %>
  <div class="d-flex justify-content-end mb-2 mt-4">
    <div class="dropdown">
      <button class="btn btn-sm btn-outline-body dropdown-toggle" type="button" id="periodButton" data-bs-toggle="dropdown">
        <i class="bi bi-calendar3"></i> <%= t(".filters.period.#{params[:period] || 'month'}") %>
      </button>

      <ul class="dropdown-menu dropdown-menu-end">
        <% period_options.each do |label, value| %>
          <li>
            <%= link_to label, charts_dashboard_path(period: value, format: :turbo_stream),
              class: "dropdown-item #{'active' if value == (params[:period] || 'month')}",
              data: { turbo_frame: :charts, turbo_prefetch: false } %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>

  <div class="row g-3 mb-5">
    <div class="col-md-6">
      <%= render layout: 'panel', locals: { accent: 'success', title: "#{t('.charts.completions')} #{t(".filters.period.#{params[:period] || 'month'}")}" } do %>
        <%= chart_tag "Line", charts[:completions_by_type], accents: %w[success orange] %>
      <% end %>
    </div>

    <div class="col-md-6">
      <%= render layout: 'panel', locals: { accent: 'success', title: t('.charts.completions_by_sheet') } do %>
        <%= chart_tag "Column", charts[:completions_by_sheet], accents: %w[success] %>
      <% end %>
    </div>

    <div class="col-12">
      <%= render layout: 'panel', locals: { accent: 'orange', title: t('.charts.diets_calories_by_sheet') } do %>
        <%= chart_tag "Bar", charts[:diets_calories], accents: %w[orange] %>
      <% end %>
    </div>
  </div>
<% end %>
