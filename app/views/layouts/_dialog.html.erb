<dialog data-controller="turbo-confirm" class="shadow rounded border p-3 mx-auto" style="width: 28rem;">
  <form method="dialog" class="d-flex flex-column gap-3">
    <div class="d-flex align-items-center justify-content-start gap-2">
      <i class="bi bi-exclamation-diamond-fill alert alert-danger rounded-circle px-2 py-1"></i>
      <p class="fw-bold fs-6"><%= t('message_destroy') %></p>
    </div>

    <div class="d-flex justify-content-end gap-2">
      <button value="cancel" class="btn btn-secondary btn-sm">
        <i class="bi bi-x"></i> <%= t("cancel") %>
      </button>
      <button value="confirm" class="btn btn-success btn-sm">
        <i class="bi bi-check-lg"></i> <%= t("confirm") %>
      </button>
    </div>
  </form>
</dialog>
