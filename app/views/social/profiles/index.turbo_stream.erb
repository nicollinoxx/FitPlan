<%= turbo_stream.replace :next_page_container, partial: "shared/profile", collection: @page.records, as: :profile %>

<% unless @page.last? %>
  <%= turbo_stream.append :paginables, partial: "shared/paginables/next_page_container", locals: { src: social_profiles_path(query: params[:query], page: @page.next_param, format: :turbo_stream) } %>
<% end %>
