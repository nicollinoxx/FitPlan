<% content_for :title, @profile.name %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>

<div class="mb-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
  <h1 class="mb-0 flex-grow-1 min-w-0">
    <%= link_to social_profiles_path(query: params[:query]), class: 'd-flex align-items-center gap-2 text-decoration-none text-body text-break' do %>
      <i class="bi bi-arrow-left-short flex-shrink-0"></i><span><%= @profile.name %></span>
    <% end %>
  </h1>

  <%= follow_toggle(@profile) %>
</div>

<div class="mt-3">
  <div class="d-flex justify-content-center align-items-center mb-3 gap-3">
    <%= link_to t('.followers', count: @followers_count), followers_social_profile_path(@profile), data: { turbo_prefetch: false }, class: 'text-primary text-decoration-none fw-semibold' %>
    <%= link_to t('.followings', count: @followings_count), followings_social_profile_path(@profile), class: 'text-primary text-decoration-none fw-semibold' %>
  </div>

  <%= render 'profile', profile: @profile %>
</div>
