<% content_for(:title, t('.title')) %>

<h1 class="mb-2"><%= t('.title') %></h1>

<%= form_with url: social_profiles_path, method: :get, data: { controller: "search", turbo_frame: "profiles" } do |form| %>
  <div class="mb-3">
    <%= form.label :query, t('search') %>
    <%= form.text_field :query, class: 'form-control', placeholder: t('.placeholder.query'), data: { action: "search#submit" } %>
  </div>
<% end %>

<%= turbo_frame_tag :profiles do %>
  <div id="paginables" class="row">
    <%= render partial: 'shared/profile', collection: @page.records, as: :profile %>
    <%= render "shared/paginables/next_page_container", src: social_profiles_path(query: params[:query], page: @page.next_param, format: :turbo_stream) unless @page.last? %>
  </div>
<% end %>