<%= turbo_stream.replace :next_page_container, partial: "recipient_form", collection: @page.records, as: :recipient, locals: { sheets: @sheets } %>

<% unless @page.last? %>
  <%= turbo_stream.append :paginables, partial: "shared/paginables/next_page_container", locals: { src: new_request_path(query: params[:query], page: @page.next_param, format: :turbo_stream) } %>
<% end %>
