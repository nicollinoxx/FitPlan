<div id="<%= dom_id(request) %>" class="d-flex align-items-center justify-content-between rounded border-start
  border-2 border-<%= sheet_color(request.sheet) %> p-2 mb-1 bg-body-tertiary shadow-sm position-relative">

  <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
    <i class="bi bi-file-earmark-spreadsheet-fill text-body-secondary flex-shrink-0"></i>
    <span class="text-truncate"><%= request.sheet.name %></span>
    <small class="badge flex-shrink-0 <%= sheet_type_badge_class(request.sheet) %>">
      <%= t request.sheet.sheet_type %>
    </small>
    <%= link_to preview_content_sheets_request_path(request), data: { turbo_frame: "_top" }, class: "stretched-link" do %>
      <span class="visually-hidden"><%= request.sheet.name %></span>
    <% end %>
  </div>

  <div class="d-flex gap-2 flex-shrink-0 ms-2 position-relative z-2">
    <% if request.pending? && request.receiver? %>
      <%= button_to sheets_request_path(request, filter: params[:filter]), method: :patch, class: "btn btn-success btn-sm", data: { turbo_confirm: t('message_destroy') } do %>
        <i class="bi bi-check2"></i>
      <% end %>
    <% end %>

    <% if request.pending? %>
      <%= button_to sheets_request_path(request, filter: params[:filter]), method: :delete, class: "btn btn-danger btn-sm", data: { turbo_confirm: t('message_destroy') } do %>
        <i class="bi bi-x-lg"></i>
      <% end %>
    <% else %>
      <span class="badge bg-success-subtle text-success fw-semibold"><%= t('request.processing') %></span>
    <% end %>
  </div>
</div>
