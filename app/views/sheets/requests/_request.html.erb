<div id="<%= dom_id(request) %>" class="d-flex align-items-center justify-content-between border-start border-2 border-<%= sheet_color(request.sheet) %> ps-2 py-1">
  <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
    <i class="bi bi-file-earmark-spreadsheet-fill text-body-secondary flex-shrink-0"></i>
    <span class="text-truncate"><%= request.sheet.name %></span>
    <small class="badge flex-shrink-0 <%= sheet_type_badge_class(request.sheet) %>">
      <%= t(request.sheet.sheet_type) %>
    </small>

    <%= link_to preview_content_sheets_request_path(request), data: { turbo_frame: "_top" }, class: "text-muted small flex-shrink-0 text-decoration-none" do %>
      <i class="bi bi-eye"></i>
    <% end %>
  </div>

  <div class="d-flex gap-2 flex-shrink-0 ms-2">
    <% if request.pending? && request.receiver? %>
      <%= button_to sheets_request_path(request, params[:filter]), method: :patch, class: "btn btn-success btn-sm rounded-circle" do %>
        <i class="bi bi-check2"></i>
      <% end %>
    <% end %>

    <%= button_to sheets_request_path(request, params[:filter]), method: :delete, class: "btn btn-danger btn-sm rounded-circle", data: { turbo_confirm: t('message_destroy') } do %>
      <i class="bi <%= request.accepted? ? 'bi-trash' : 'bi-x-lg' %>"></i>
    <% end %>
  </div>
</div>
