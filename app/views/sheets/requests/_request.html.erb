<div id="<%= dom_id(request) %>" class="d-flex align-items-center justify-content-between border-start border-2 <%= request.sheet.workout? ? 'border-success' : 'border-warning' %> ps-2 py-1">
  <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
    <i class="bi bi-file-earmark-spreadsheet-fill text-body-secondary flex-shrink-0"></i>
    <span class="text-truncate"><%= request.sheet.name %></span>
    <small class="badge flex-shrink-0 <%= request.sheet.workout? ? 'bg-danger-subtle text-danger' : 'bg-warning-subtle text-warning' %>">
      <%= request.sheet.workout? ? t('workout') : t('diet') %>
    </small>

    <%= link_to preview_path(request, filter: params[:filter]), data: { turbo_frame: "_top" }, class: "text-muted small flex-shrink-0 text-decoration-none" do %>
      <i class="bi bi-eye"></i>
    <% end %>

    <% if request.sheet.description.present? %>
      <a class="text-muted small flex-shrink-0 text-decoration-none" data-bs-toggle="collapse" href="#desc-<%= request.id %>" role="button" aria-expanded="false">
        <i class="bi bi-blockquote-right"></i>
      </a>
    <% end %>
  </div>

  <div class="d-flex gap-2 flex-shrink-0 ms-2">
    <% if request.pending? && request.receiver? %>
      <%= button_to sheets_request_path(request), method: :patch, class: "btn btn-success btn-sm rounded-circle" do %>
        <i class="bi bi-check2"></i>
      <% end %>
    <% end %>

    <% if request.sender? || request.receiver? %>
      <%= button_to sheets_request_path(request), method: :delete, class: "btn btn-danger btn-sm rounded-circle", data: { turbo_confirm: t('message_destroy') } do %>
        <i class="bi <%= request.accepted? ? 'bi-trash' : 'bi-x-lg' %>"></i>
      <% end %>
    <% end %>
  </div>

  <% if request.sheet.description.present? %>
    <div class="collapse w-100 mt-1 bg-secondary-subtle rounded py-1 px-2" id="desc-<%= request.id %>">
      <%= request.sheet.description %>
    </div>
  <% end %>
</div>
