<% content_for(:title, @sheet.name) %>

<h1 class="mb-3">
  <%= link_to :back, class: 'd-flex align-items-center gap-2 text-decoration-none text-body' do %>
    <i class="bi bi-arrow-left-short"></i><%= @sheet.name %>
  <% end %>
</h1>

<small class="text-muted d-block mb-3">
  <%= @sheet.workout? ? t('workout') : t('diet') %>
  <% if @sheet.description.present? %>
    &middot; <%= @sheet.description %>
  <% end %>
</small>

<div class="d-flex flex-column" style="min-height: calc(100vh - 160px);">
  <% if @sheet.workout? %>
    <div class="row">
      <% @workouts.each do |workout| %>
        <div class="col-md-6 mb-4">
          <%= render workout, completion: nil %>
        </div>
      <% end %>
    </div>

    <%= image_tag 'undraw/working_out.svg', alt: '', class: 'img-fluid mt-auto ms-auto', style: 'width: 25rem;' %>
  <% else %>
    <div class="row mb-3">
      <% @diets.each do |diet| %>
        <div class="col-md-6 p-2 mb-2">
          <%= render diet, completed: nil %>
        </div>
      <% end %>
    </div>

    <%= image_tag 'undraw/cooking.svg', alt: '', class: 'img-fluid mt-auto ms-auto', style: 'width: 25rem;' %>
  <% end %>
</div>
