<div class="ms-auto dropdown">
  <button class="btn btn-sm <%= sheet_filter_applied? ? 'btn-secondary' : 'btn-outline-body' %> dropdown-toggle" type="button" data-bs-toggle="dropdown">
    <i class="bi bi-funnel-fill"></i> <%= t('.filter') %>
  </button>

  <ul class="dropdown-menu dropdown-menu-end">
    <li><h6 class="dropdown-header"><%= t('.filters.type') %></h6></li>

    <li>
      <%= link_to sheets_path(sheet_filter_params(type: 'workout')),
        class: "dropdown-item #{'active' if params[:type] == 'workout'}" do %>

        <i class="bi bi-heart-pulse me-2"></i> <%= t('workout') %>
      <% end %>
    </li>

    <li>
      <%= link_to sheets_path(sheet_filter_params(type: 'diet')),
        class: "dropdown-item #{'active' if params[:type] == 'diet'}" do %>

        <i class="bi bi-egg-fried me-2"></i> <%= t('diet') %>
      <% end %>
    </li>

    <li>
      <%= link_to sheets_path(sheet_filter_params(type: nil)),
        class: "dropdown-item #{'active' unless params[:type]}" do %>

        <i class="bi bi-list-ul me-2"></i> <%= t('all') %>
      <% end %>
    </li>

    <li><hr class="dropdown-divider"></li>

    <li><h6 class="dropdown-header"><%= t('.filters.status') %></h6></li>

    <li>
      <%= link_to sheets_path(sheet_filter_params(completed: params[:completed] == 'true' ? nil : 'true')),
        class: "dropdown-item #{'active' if params[:completed] == 'true'}" do %>

        <i class="bi bi-check-lg me-2"></i> <%= t('completed') %>
      <% end %>
    </li>

    <li>
      <%= link_to sheets_path(sheet_filter_params(completed: params[:completed] == 'false' ? nil : 'false')),
        class: "dropdown-item #{'active' if params[:completed] == 'false'}" do %>

        <i class="bi bi-x-lg me-2"></i> <%= t('uncompleted') %>
      <% end %>
    </li>
  </ul>
</div>
