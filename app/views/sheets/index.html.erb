<% content_for(:title, t('.title')) %>

<div data-controller="sortable" data-sortable-resource-value="sheet">
  <div class="d-flex justify-content-between align-items-center">
    <h1><%= t('.title') %></h1>

    <div class="d-flex gap-2">
      <%= render "shared/sort_button" if @user.sheets.many? && !turbo_native_app? %>
      <%= link_to t('new'), new_sheet_path, data: { controller: "bridge--nav-button", bridge_title: t('new') }, class: 'btn btn-success' %>
    </div>
  </div>

  <div class="d-flex flex-column" style="min-height: calc(100vh - 160px);">
    <%= turbo_frame_tag "sheets_page", data: { controller: "frame-location", action: "turbo:frame-load->frame-location#sync" } do %>
      <div class="d-flex align-items-center justify-content-between mt-1">
        <%= render 'search' %>
        <%= render 'filter' %>
      </div>

      <div class="d-flex align-items-center justify-content-between mt-4 mb-2">
        <%= render 'legend' %>
        <%= render "shared/sort_button" if @user.sheets.many? && turbo_native_app? %>
      </div>

      <%= turbo_frame_tag "sheets" do %>
        <div id="paginables" class="row mb-3" data-sortable-target="list">
          <%= render partial: "sheet", collection: @page.records, as: :sheet %>
          <%= render "shared/paginables/next_page_container", src: sheets_path(page: @page.next_param, format: :turbo_stream) unless @page.last? %>
        </div>
      <% end %>
    <% end %>

    <%= image_tag 'undraw/grading_papers.svg', alt: '', class: 'img-fluid mt-auto ms-auto', style: 'width: 25rem;' %>
  </div>
</div>
