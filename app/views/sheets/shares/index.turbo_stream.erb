<%= turbo_stream.replace :next_page_container, partial: "sheets/shares/share", collection: @page.records, as: :share %>

<% unless @page.last? %>
  <%= turbo_stream.append :paginables, partial: "shared/paginables/next_page_container",
    locals: { src: sheets_shares_path(page: @page.next_param, format: :turbo_stream) } %>
<% end %>
