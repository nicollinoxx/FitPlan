<div class="text-center mx-auto py-4" style="max-width: 32rem;" data-controller="hint">
  <i class="bi bi-stars text-success display-5"></i>

  <h2 class="h5 mt-2 d-flex align-items-center justify-content-center gap-2">
    <%= t('.title') %>

    <button type="button" class="btn btn-link btn-sm p-0 lh-1 text-body-secondary" aria-label="<%= t('.about') %>"
      data-action="hint#show" data-hint-title-param="<%= t('.about') %>" data-hint-body-param="<%= t('.summary') %>">
      <i class="bi bi-info-circle"></i>
    </button>
  </h2>

  <p class="text-muted"><%= t('.description') %></p>

  <%= button_to open_router_connection_path, form: { data: { turbo: false } }, class: "btn btn-success" do %>
    <i class="bi bi-plug me-1"></i><%= t('.connect') %>
  <% end %>

  <%= render "shared/hint_dialog" %>
</div>
