<template data-recommendations--generate-target="workoutTemplate">
  <div class="col-md-6 mb-3">
    <div class="shadow-sm bg-body-tertiary rounded border h-100 pulse-suggested-success">
      <div class="bg-success text-light bg-opacity-20 p-2 rounded-top">
        <h4 class="h6 mb-0 text-truncate"><i class="bi bi-activity me-1"></i><span data-field="exercise"></span></h4>
      </div>

      <div class="p-3 d-flex flex-wrap gap-2">
        <div class="border text-center p-2 rounded flex-grow-1" style="min-width: 45%">
          <p class="small text-muted mb-0"><i class="bi bi-repeat"></i> <%= t('series') %></p>
          <p class="fw-bold mb-0" data-field="series"></p>
        </div>

        <div class="border text-center p-2 rounded flex-grow-1" style="min-width: 45%">
          <p class="small text-muted mb-0"><i class="bi bi-arrow-repeat"></i> <%= t('repetitions') %></p>
          <p class="fw-bold mb-0" data-field="repetitions"></p>
        </div>

        <div class="border text-center p-2 rounded flex-grow-1" style="min-width: 45%">
          <p class="small text-muted mb-0"><i class="bi bi-stopwatch"></i> <%= t('interval') %></p>
          <p class="fw-bold mb-0" data-field="interval"></p>
        </div>

        <div class="border text-center p-2 rounded flex-grow-1" style="min-width: 45%">
          <p class="small text-muted mb-0"><i class="bi bi-weight"></i> <%= t('charge') %></p>
          <p class="fw-bold mb-0" data-field="charge"></p>
        </div>
      </div>
    </div>
  </div>
</template>
