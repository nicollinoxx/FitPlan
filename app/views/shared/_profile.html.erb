<% unseen = local_assigns[:unseen] %>

<div class="col-md-6 mb-3">
  <%= link_to profile_action_link(profile), data: {turbo_frame: '_top'}, class: 'text-decoration-none' do %>
    <div class="d-flex align-items-center justify-content-between p-3 bg-body-tertiary shadow-sm rounded border-start border-4 <%= unseen ? "border-warning" : "border-success" %>">
      <div class="d-flex align-items-center gap-3 w-100">
        <% avatar_border = unseen ? "border-warning" : "border-success-subtle" %>

        <% if profile.avatar.attached? %>
          <%= image_tag profile.avatar, class: "rounded-circle border #{avatar_border} border-3 object-fit-cover", width: 56, height: 56 %>
        <% else %>
          <span class="d-inline-flex align-items-center justify-content-center rounded-circle border <%= avatar_border %> border-3"
                style="width: 56px; height: 56px;">
            <i class="bi bi-person-fill text-body"></i>
          </span>
        <% end %>

        <div class="flex-grow-1 overflow-hidden min-w-0">
          <h6 class="fw-semibold mb-1 text-truncate text-body"><%= profile.name %></h6>
          <p class="text-muted small mb-0 text-truncate">@<%= profile.handle %></p>

          <% if unseen %>
            <p class="text-warning small mb-0 text-truncate"><%= t('social.profiles.followers.unseen') %></p>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>
