<div id="flash_container" class="position-sticky z-3" style="top: 8px;">
  <div class="container mt-1 mb-3 hide-on-mobile">
    <div class="alert alert-dark py-2 rounded mb-0 d-flex align-items-center gap-2" role="alert" data-controller="toast bridge--flash-message"
         data-bridge-title="<%= "#{follower.name_without_links} #{t('toast.new_follower')}" %>">
      <span>
        <%= follower.name_without_links %>
        <%= t('toast.new_follower') %>
      </span>

      <%= link_to t('toast.view'), followers_social_profile_path(followed), class: "btn btn-sm btn-outline-light py-0",
            data: { turbo_prefetch: false } %>
      <button type="button" class="btn-close text-body ms-1" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  </div>
</div>
