<% content_for(:title, t('.title')) %>

<div class="d-flex flex-column min-vh-100">
  <h1 class="pb-2 pt-3 mt-md-5">
    <%= link_to welcome_path, class: 'd-flex align-items-center gap-2 text-decoration-none text-body' do %>
      <i class="bi bi-arrow-left-short"></i><%= t('back') %>
    <% end %>
  </h1>

  <div class="d-flex align-items-center justify-content-center flex-grow-1">
    <div class="d-flex flex-column-reverse flex-md-row align-items-center gap-5 w-100">
    <%= image_tag "undraw/mindfulness.svg", alt: "", class: "img-fluid" %>

    <div class="w-100 bg-body-tertiary border rounded p-4 shadow position-relative">
      <div class="position-absolute top-0 end-0 m-2">
        <%= render 'shared/language_dropdown' %>
      </div>

      <h1 class="text-center fw-bold">
        <%= image_tag 'logo.svg', alt: '', aria: { hidden: true }, class: 'img-fluid d-block mx-auto mb-1' %>
        Fit<span class="text-success">Plan</span>
      </h1>

      <%= form_with(url: sign_in_path, class: 'mb-4', data: { controller: "redirect", redirect_url_value: root_path }) do |form| %>
        <div class="mb-4">
          <%= form.label :email, class: 'form-label' %>
          <%= form.email_field :email, value: params[:email_hint], required: true, autofocus: true, class: 'form-control', placeholder: t('.form.placeholder.email') %>
        </div>

        <div class="mb-4">
          <div class="d-flex justify-content-between">
            <%= form.label :password, t('.form.label.password'), class: 'form-label' %>
            <%= link_to t('.link_forgot_password'), new_identity_password_reset_path, class: 'small' %>
          </div>

          <div class="position-relative" data-controller="password-visibility">
            <%= form.password_field :password, required: true, class: 'form-control pe-5', placeholder: "••••••••", data: { "password-visibility-target": "input" } %>
            <button class="btn btn-link position-absolute top-50 end-0 translate-middle-y pe-2 text-body-secondary border-0" type="button" data-action="password-visibility#toggle" aria-label="<%= t('toggle_password_visibility') %>">
              <i class="bi bi-eye" data-password-visibility-target="icon"></i>
            </button>
          </div>
        </div>

        <div class="mb-4">
          <%= form.submit t(".submit"), class: 'btn btn-success w-100' %>
        </div>
      <% end %>

      <div class="mt-3">
        <p class="mb-1"><%= t('.section_signup') %></p>
        <%= link_to t('.signup'), sign_up_path, class: 'btn btn-orange w-100' %>
      </div>
    </div>
    </div>
  </div>
</div>
