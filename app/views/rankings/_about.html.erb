<details class="mb-3">
  <summary class="text-muted" style="cursor: pointer;"><%= t('rankings.description') %></summary>

  <div class="mt-2 p-3 bg-body-tertiary rounded small">
    <p class="mb-2">
      <i class="bi bi-graph-up-arrow text-success me-1"></i>
      <strong><%= t('rankings.about.consistency') %></strong> <%= t('rankings.about.consistency_text') %>
    </p>

    <p class="mb-2">
      <i class="bi bi-fire text-orange me-1"></i>
      <strong><%= t('rankings.about.streak') %></strong> <%= t('rankings.about.streak_text') %>
    </p>

    <p class="mb-2">
      <i class="bi bi-people text-success me-1"></i>
      <strong><%= t('rankings.about.friends') %></strong> <%= t('rankings.about.friends_text') %>
    </p>

    <p class="mb-0 text-muted">
      <i class="bi bi-info-circle me-1"></i><%= t('rankings.about.note') %>
    </p>
  </div>
</details>
