<% content_for(:title, t('.title')) %>

<h1><%= t('.title') %></h1>
<p class="text-muted"><%= t('rankings.description') %></p>

<%= render 'tabs' %>
<%= render 'summary' %>

<div id="paginables" class="mb-3">
  <%= render partial: 'ranking', collection: @page.records, as: :ranking, locals: { offset: @offset } %>
  <%= render 'shared/paginables/next_page_container', src: friends_rankings_path(page: @page.next_param, format: :turbo_stream) unless @page.last? %>
</div>

<% unless @has_friends %>
  <div class="text-center py-5 text-muted">
    <i class="bi bi-people fs-1 d-block mb-3"></i>
    <p><%= t('.empty') %></p>
    <%= link_to t('.find_friends'), social_profiles_path, class: 'btn btn-success' %>
  </div>
<% end %>
