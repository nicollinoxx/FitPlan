<div class="row g-3 mb-4">
  <div class="col-4">
    <div class="h-100 p-3 text-center bg-body-tertiary shadow-sm rounded border-bottom border-4 border-warning">
      <i class="bi bi-award-fill fs-4 d-block mb-1 text-warning"></i>
      <p class="h4 fw-bold mb-0"><%= @user.ranked? ? "##{@user.ranking_position}" : '—' %></p>
      <p class="text-muted small mb-0"><%= t('rankings.summary.position') %></p>
    </div>
  </div>

  <div class="col-4">
    <div class="h-100 p-3 text-center bg-body-tertiary shadow-sm rounded border-bottom border-4 border-success">
      <i class="bi bi-graph-up-arrow fs-4 d-block mb-1 text-success"></i>
      <p class="h4 fw-bold mb-0"><%= number_with_precision(@user.ranking_score, precision: 0) %></p>
      <p class="text-muted small mb-0"><%= t('rankings.summary.score') %></p>
    </div>
  </div>

  <div class="col-4">
    <div class="h-100 p-3 text-center bg-body-tertiary shadow-sm rounded border-bottom border-4 border-orange">
      <i class="bi bi-fire fs-4 d-block mb-1 text-orange"></i>
      <p class="h4 fw-bold mb-0"><%= @user.current_streak %></p>
      <p class="text-muted small mb-0"><%= t('rankings.summary.streak') %></p>
    </div>
  </div>
</div>

<% unless @user.ranked? %>
  <p class="text-muted small text-center mb-4">
    <i class="bi bi-info-circle me-1"></i><%= t('rankings.summary.unranked') %>
  </p>
<% end %>
